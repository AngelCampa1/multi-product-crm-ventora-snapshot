{
  "name": "ventora-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Internal customer hub + wall of fame for the Ventora product portfolio.",
  "author": "Angel Campa",
  "scripts": {
    "dev": "concurrently --kill-others \"vite build --watch --config admin/vite.config.ts\" \"wrangler dev\"",
    "dev:worker": "wrangler dev",
    "dev:admin": "vite --config admin/vite.config.ts",
    "build:admin": "vite build --config admin/vite.config.ts",
    "deploy": "npm run deploy:rollout",
    "deploy:worker": "npm run build:admin && wrangler deploy",
    "deploy:phase1:schema": "npm run verify:migration:remote:preflight && wrangler d1 migrations apply ventora-crm --remote --config wrangler.phase1.jsonc && npm run verify:migration:remote:phase1",
    "deploy:phase2:schema": "tsx scripts/verify-deployed-worker.ts && wrangler d1 migrations apply ventora-crm --remote && npm run db:seed:remote && npm run db:origins:remote && npm run verify:migration:remote",
    "deploy:retired-products:cleanup": "npm run db:retire-products:remote && npm run db:origins:remote && npm run verify:migration:remote",
    "deploy:rollout": "npm run verify:rollout && npm run deploy:retired-products:cleanup && npm run deploy:rollout:staged",
    "deploy:rollout:staged": "npm run deploy:phase1:schema && npm run deploy:worker && npm run deploy:phase2:schema",
    "deploy:schema": "npm run deploy:rollout",
    "deploy:dry-run": "npm run build:admin && wrangler deploy --dry-run",
    "verify:rollout": "npm run lint && npm run typecheck && npm run test:coverage && npm run verify:migration:phase1:local && npm run db:migrate && npm run db:seed && npm run db:retire-products && npm run db:origins && npm run verify:migration && npm run verify:firewall && npm run verify:media && npm run test:e2e && npm run deploy:dry-run && npm audit --omit=dev --audit-level=moderate",
    "db:migrate": "wrangler d1 migrations apply ventora-crm --local",
    "db:migrate:remote": "node -e \"console.error('Remote schema changes are staged around a Worker deploy; use npm run deploy:rollout.'); process.exit(1)\"",
    "db:seed": "tsx scripts/seed-products.ts",
    "db:seed:remote": "tsx scripts/seed-products.ts --remote",
    "db:retire-products": "tsx scripts/remove-retired-products.ts",
    "db:retire-products:remote": "tsx scripts/remove-retired-products.ts --remote",
    "db:origins": "tsx scripts/configure-product-origins.ts",
    "db:origins:remote": "tsx scripts/configure-product-origins.ts --remote",
    "verify:migration": "tsx scripts/verify-migration-state.ts",
    "verify:migration:remote": "tsx scripts/verify-migration-state.ts --remote",
    "verify:migration:preflight": "tsx scripts/verify-migration-preflight.ts",
    "verify:migration:remote:preflight": "tsx scripts/verify-migration-preflight.ts --remote",
    "verify:migration:phase1:local": "tsx scripts/verify-local-phase1-rollout.ts",
    "verify:migration:remote:phase1": "tsx scripts/verify-migration-phase1.ts --remote",
    "verify:firewall": "tsx scripts/verify-firewall-triggers.ts",
    "verify:media": "tsx scripts/verify-media-triggers.ts",
    "test": "vitest run",
    "test:admin": "vitest run -c admin/vitest.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "metrics": "node scripts/repo-metrics.mjs --write",
    "metrics:check": "node scripts/repo-metrics.mjs --check",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "shots": "tsx scripts/demo-shots.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^9.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sentry/react": "^10.53.1",
    "@tanstack/react-query": "^5.62.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.6.0",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "eslint": "^8.57.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.6",
    "wrangler": "^4.93.0"
  },
  "overrides": {
    "ws": "8.20.1"
  }
}
